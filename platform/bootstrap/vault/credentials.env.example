# Скопируйте в credentials.env в корне репозитория (файл в .gitignore).
# Заполните после первого запуска: make vault-bootstrap
# (скрипт выведет VAULT_ROOT_TOKEN и VAULT_UNSEAL_KEY_1..5).

VAULT_ROOT_TOKEN=""
VAULT_UNSEAL_KEY_1=""
VAULT_UNSEAL_KEY_2=""
VAULT_UNSEAL_KEY_3=""
# при пороге 3 достаточно первых трёх ключей для unseal
# VAULT_UNSEAL_KEY_4=""
# VAULT_UNSEAL_KEY_5=""
